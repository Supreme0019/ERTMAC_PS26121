# Copy to .env (never commit .env). Postgres needs the PostGIS and pgvector extensions (Neon works).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Optional: a separate model just for document extraction (free-tier quotas are per model)
EXTRACT_MODEL=
EMBED_MODEL=BAAI/bge-small-en-v1.5
