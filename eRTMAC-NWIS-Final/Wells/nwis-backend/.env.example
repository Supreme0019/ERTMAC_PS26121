# =============================================================================
# NWIS Backend — Environment Variable Template
# =============================================================================
# INSTRUCTIONS:
#   1. cp .env.example .env
#   2. Fill in every REPLACE_WITH_* value before starting the server.
#   3. Never commit your filled-in .env — it is already in .gitignore.
#
# Generate JWT secrets (run once, copy the output for each key):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# WARNING: The server will refuse to start in NODE_ENV=production if any
#          required secret is missing or still set to a placeholder value.
# =============================================================================

NODE_ENV=development
PORT=4001

# ── Database ──────────────────────────────────────────────────────────────────
# Obtain from Neon console → Project → Connection Details → Pooled connection
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>/<DBNAME>?sslmode=require&channel_binding=require&uselibpqcompat=true

# Used by docker-compose to initialise the local PostgreSQL container.
# Must match the credentials embedded in DATABASE_URL when running locally.
POSTGRES_USER=REPLACE_WITH_DB_USERNAME
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=nwis_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be cryptographically random and at least 32 bytes (64 hex chars).
# The two secrets MUST be different from each other.
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_DIFFERENT_FROM_ABOVE
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── AI Service ────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── Object Storage (S3 / MinIO) ───────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nwis-documents
S3_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY

# ── Embedding ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
# Allowed: fatal | error | warn | info | debug | trace
# Do NOT set to debug in production — it leaks request/response bodies.
LOG_LEVEL=info

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
